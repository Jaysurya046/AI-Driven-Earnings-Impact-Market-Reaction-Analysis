```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Dependencies
node_modules/

# Logs
*.log

# Editors
.vscode/
.idea/

# Build artifacts
dist/
build/
target/

# Coverage
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/
```