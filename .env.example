# ==============================================================================
# AI-Driven Earnings Impact & Market Reaction Analysis
# Environment Configuration & Secrets Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials.
# NOTE: Never commit live credentials or '.env' to version control.

# --- Security & API Configuration ---
API_SECRET_KEY=your_secure_api_secret_key_here
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# --- Data Collection Universe & Parameters ---
LOOKBACK_YEARS=5
TICKERS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,JNJ,PG,V,UNH,HD,BAC,MA,XOM,DIS,CSCO,PFE,NFLX

# --- Event Study Parameters ---
EVENT_WINDOW=5
ESTIMATION_WINDOW=60
LABEL_THRESHOLD=0.0

# --- Machine Learning & Validation ---
TEST_SIZE=0.2
RANDOM_STATE=42
MODELS_TO_TRAIN=logistic_regression,random_forest,xgboost

# --- Directories ---
DATA_DIR=data
MODELS_DIR=models
VIZ_DIR=visualizations

